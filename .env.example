# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# LLM Configuration (for explanations)
# Option 1: OpenAI
OPENAI_API_KEY=your-openai-api-key-here
LLM_MODEL=gpt-4o-mini

# Option 2: Groq (faster, cheaper alternative)
# GROQ_API_KEY=your-groq-api-key-here
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Backend Connection
# In production, configure connection to Pathway backend:
# - Pathway REST connector URL
# - Shared database connection
# - Message queue endpoint
PATHWAY_BACKEND_URL=http://localhost:8080
STORAGE_PATH=./storage
